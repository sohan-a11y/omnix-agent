<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/omnix_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="32dp">

        <!-- ── Header ─────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="52sp"
            android:textColor="@color/omnix_text_primary"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.15"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_subtitle"
            android:textSize="15sp"
            android:textColor="@color/omnix_accent"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- Live status pill -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_status_pill"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="32dp">

            <View
                android:id="@+id/dot_status"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_status_dot_red"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tv_live_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_status_setup_required"
                android:textSize="12sp"
                android:textColor="@color/omnix_text_secondary" />
        </LinearLayout>

        <!-- ── Card 1: Accessibility ──────────────────────── -->
        <LinearLayout
            android:id="@+id/card_accessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <View
                    android:id="@+id/dot_accessibility"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_status_dot_red"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/onboarding_accessibility_title"
                    android:textColor="@color/omnix_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_accessibility_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/badge_required"
                    android:textSize="10sp"
                    android:textColor="@color/omnix_red"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_accessibility_desc"
                android:textColor="@color/omnix_text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_grant_accessibility"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/btn_enable_in_settings"
                android:textSize="13sp"
                android:backgroundTint="@color/omnix_accent" />
        </LinearLayout>

        <!-- ── Card 2: Overlay ────────────────────────────── -->
        <LinearLayout
            android:id="@+id/card_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <View
                    android:id="@+id/dot_overlay"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_status_dot_red"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/onboarding_overlay_title"
                    android:textColor="@color/omnix_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_overlay_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/badge_required"
                    android:textSize="10sp"
                    android:textColor="@color/omnix_red"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_overlay_desc"
                android:textColor="@color/omnix_text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_grant_overlay"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/btn_grant_permission"
                android:textSize="13sp"
                android:backgroundTint="@color/omnix_accent" />
        </LinearLayout>

        <!-- ── Card 3: Voice Model ────────────────────────── -->
        <LinearLayout
            android:id="@+id/card_voice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <View
                    android:id="@+id/dot_voice"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_status_dot_yellow"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/onboarding_voice_title"
                    android:textColor="@color/omnix_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_voice_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/badge_auto"
                    android:textSize="10sp"
                    android:textColor="@color/omnix_yellow"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_vosk_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_status_checking"
                android:textColor="@color/omnix_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ── Card 4: AI Model ───────────────────────────── -->
        <LinearLayout
            android:id="@+id/card_ai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <View
                    android:id="@+id/dot_ai"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_status_dot_yellow"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/onboarding_ai_title"
                    android:textColor="@color/omnix_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_ai_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/badge_optional"
                    android:textSize="10sp"
                    android:textColor="@color/omnix_blue"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_ai_desc"
                android:textColor="@color/omnix_text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <ProgressBar
                android:id="@+id/progress_download"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:max="100"
                android:progress="0"
                android:visibility="gone"
                android:progressTint="@color/omnix_accent"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tv_download_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/omnix_text_secondary"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btn_download_model"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/onboarding_btn_download_gemma"
                android:textSize="13sp"
                android:backgroundTint="@color/omnix_bg_card2" />
        </LinearLayout>

        <!-- ── Card 5: App Learning ───────────────────────── -->
        <LinearLayout
            android:id="@+id/card_discovery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <View
                    android:id="@+id/dot_discovery"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_status_dot_yellow"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/onboarding_discovery_title"
                    android:textColor="@color/omnix_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_discovery_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/badge_auto"
                    android:textSize="10sp"
                    android:textColor="@color/omnix_yellow"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress_discovery"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:max="100"
                android:progress="0"
                android:visibility="gone"
                android:progressTint="@color/omnix_green"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tv_discovery_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_discovery_desc"
                android:textColor="@color/omnix_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ── Launch Button ──────────────────────────────── -->
        <Button
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/onboarding_btn_launch"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:backgroundTint="@color/omnix_accent"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tv_start_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text='Say "Hi AI" after launching'
            android:textColor="@color/omnix_text_secondary"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <!-- Chat entry point -->
        <Button
            android:id="@+id/btn_open_chat"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/onboarding_btn_chat"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="@color/omnix_bg_card2"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
